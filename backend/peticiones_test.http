@baseUrl = http://127.0.0.1:3000/api

#####################################################
### Health check
#####################################################
GET {{baseUrl}}/health/ HTTP/1.1

#####################################################
### Ingrediente
#####################################################
### Listar todos los ingredientes
GET {{baseUrl}}/ingredientes HTTP/1.1

### Obtener un ingrediente (reemplazar el id)
GET {{baseUrl}}/ingredientes/ID HTTP/1.1

### Crear ingrediente
POST {{baseUrl}}/ingredientes HTTP/1.1
Content-Type: application/json

{
  "nombre": "Calabaza",
  "unidadMedida": "gramos",
  "calorias": 26
}

### Actualizar ingrediente (PATCH: solo los campos que cambian)
PATCH {{baseUrl}}/ingredientes/ID HTTP/1.1
Content-Type: application/json

{
  "calorias": 30
}

### Eliminar ingrediente
DELETE {{baseUrl}}/ingredientes/ID HTTP/1.1

#####################################################
### Autor
#####################################################
### Listar todos los autores
GET {{baseUrl}}/autores HTTP/1.1

### Obtener un autor (reemplazar el id)
GET {{baseUrl}}/autores/ID HTTP/1.1

### Crear autor
POST {{baseUrl}}/autores HTTP/1.1
Content-Type: application/json

{
  "apellido": "Dominguez",
  "nombre": "Ana",
  "pais": "Argentina"
}

### Actualizar autor (PATCH: solo los campos que cambian)
PATCH {{baseUrl}}/autores/ID HTTP/1.1
Content-Type: application/json

{
  "pais": "Uruguay"
}

### Eliminar autor
DELETE {{baseUrl}}/autores/ID HTTP/1.1

#####################################################
### Categoria
#####################################################
### Listar todas las categorías
GET {{baseUrl}}/categorias HTTP/1.1

### Obtener una categoría (reemplazar el id)
GET {{baseUrl}}/categorias/ID HTTP/1.1

### Crear categoría
POST {{baseUrl}}/categorias HTTP/1.1
Content-Type: application/json

{
  "nombre": "Sopas",
  "descripcion": "Sopas y caldos calientes"
}

### Actualizar categoría (PATCH: solo los campos que cambian)
PATCH {{baseUrl}}/categorias/ID HTTP/1.1
Content-Type: application/json

{
  "descripcion": "Sopas, cremas y caldos para el invierno"
}

### Eliminar categoría
DELETE {{baseUrl}}/categorias/ID HTTP/1.1

#####################################################
### Receta
#####################################################
### Listar todas las recetas
GET {{baseUrl}}/recetas HTTP/1.1

### Obtener una receta (reemplazar el id)
GET {{baseUrl}}/recetas/ID HTTP/1.1

### Crear receta (reemplazar los ids de ingredientes, autor y categoria)
POST {{baseUrl}}/recetas HTTP/1.1
Content-Type: application/json

{
  "titulo": "Sopa de calabaza",
  "descripcion": "Crema de calabaza asada. 500 g de calabaza, 1 cebolla y 1 litro de caldo.",
  "tiempoPreparacion": 40,
  "porciones": 4,
  "dificultad": "media",
  "ingredientes": ["ID_INGREDIENTE_1", "ID_INGREDIENTE_2"],
  "autor": "ID_AUTOR",
  "categoria": "ID_CATEGORIA"
}

### Actualizar receta (PATCH: solo los campos que cambian)
PATCH {{baseUrl}}/recetas/ID HTTP/1.1
Content-Type: application/json

{
  "porciones": 5
}

### Eliminar receta
DELETE {{baseUrl}}/recetas/ID HTTP/1.1

#####################################################
### Menu
#####################################################
### Listar todos los menús
GET {{baseUrl}}/menus HTTP/1.1

### Obtener un menú (reemplazar el id)
GET {{baseUrl}}/menus/ID HTTP/1.1

### Crear menú (reemplazar los ids de recetas)
POST {{baseUrl}}/menus HTTP/1.1
Content-Type: application/json

{
  "nombre": "Menu de invierno",
  "tipoComida": "merienda",
  "recetas": ["ID_RECETA_1", "ID_RECETA_2"]
}

### Actualizar menú (PATCH: solo los campos que cambian)
PATCH {{baseUrl}}/menus/ID HTTP/1.1
Content-Type: application/json

{
  "tipoComida": "desayuno"
}

### Eliminar menú
DELETE {{baseUrl}}/menus/ID HTTP/1.1
